#!/data/data/com.termux/files/usr/bin/python3

import argparse
import bz2
import datetime
import glob
import gzip
import hashlib
import os
import re
import shlex
import shutil
import subprocess
import sys

HASHES = ['md5', 'sha1', 'sha256', 'sha512']
SUPPORTED_ARCHES = ['all', 'arm', 'i686', 'aarch64', 'x86_64']
ORIGIN = 'termux-apt-repo'
DESCRIPTION = 'termux-apt-repo (personal Termux package repository)'


def run_shell_command(cmd):
    try:
        return subprocess.check_output(
            cmd, shell=True, universal_newlines=True,
            stderr=subprocess.DEVNULL).strip()
    except subprocess.CalledProcessError:
        return None


def control_file_contents(debfile):
    file_list = run_shell_command('ar t {}'.format(debfile))
    if file_list is None:
        sys.exit("Error listing contents of '{}'".format(debfile))

    file_list = file_list.split('\n')

    if 'control.tar.gz' in file_list:
        control_filename, tar_args = 'control.tar.gz', '-z'
    elif 'control.tar.xz' in file_list:
        control_filename, tar_args = 'control.tar.xz', '-J'
    elif 'control.tar.zst' in file_list:
        control_filename, tar_args = 'control.tar.zst', '--zstd'
    else:
        sys.exit("Failed to find control file in '{}'".format(debfile))

    cmd = ('ar p {} {} | tar -O {} -xf - ./control'
           ' || ar p {} {} | tar -O {} -xf - control').format(
        debfile, control_filename, tar_args,
        debfile, control_filename, tar_args)
    contents = run_shell_command(cmd)
    if contents is None:
        sys.exit("Error extracting control file from '{}'".format(debfile))

    return contents


def list_package_files(debfile):
    file_list = run_shell_command('ar t {}'.format(debfile))
    if file_list is None:
        return []

    if 'data.tar.xz' in file_list:
        cmd = 'ar p {} data.tar.xz | tar -tJ'.format(debfile)
    elif 'data.tar.gz' in file_list:
        cmd = 'ar p {} data.tar.gz | tar -tz'.format(debfile)
    elif 'data.tar.zst' in file_list:
        cmd = 'ar p {} data.tar.zst | tar --zstd -t'.format(debfile)
    else:
        return []

    try:
        listing = subprocess.check_output(
            cmd, shell=True, universal_newlines=True, stderr=subprocess.DEVNULL)
    except subprocess.CalledProcessError:
        return []

    return [f.strip('./') for f in listing.splitlines()
            if f and not f.endswith('/')]


def hash_file(path):
    with open(path, 'rb') as f:
        data = f.read()
    return {h: getattr(hashlib, h)(data).hexdigest() for h in HASHES}


def parse_deb(debfile):
    control = control_file_contents(debfile)
    name = re.search(r'^Package: (.*)$', control, re.M).group(1)
    version = re.search(r'^Version: (.*)$', control, re.M).group(1)
    arch = re.search(r'^Architecture: (.*)$', control, re.M).group(1)
    return name, version, arch, control


def main():
    parser = argparse.ArgumentParser(
        description='Create a Termux-style apt repository from .deb files')
    parser.add_argument('input', metavar='input', type=str,
                        help='folder where .deb files are located')
    parser.add_argument('output', metavar='output', type=str,
                        help='folder with repository tree')
    parser.add_argument('distribution', metavar='dist', type=str, nargs='?',
                        default='stable',
                        help='name of distribution folder (default: stable)')
    parser.add_argument('component', metavar='comp', type=str, nargs='?',
                        default='main',
                        help='name of component folder (default: main)')
    parser.add_argument('--use-hard-links', action='store_true',
                        help='use hard links instead of copying deb files')
    parser.add_argument('-s', '--sign', action='store_true',
                        help='sign repo with GPG key')
    parser.add_argument('--base-url', metavar='URL', type=str, default=None,
                        help='write absolute URLs (URL/<file>.deb) into the '
                             'Filename field instead of pool-relative paths; '
                             'use when the .deb files are hosted somewhere else')
    parser.add_argument('--strip-debs', action='store_true',
                        help='delete the copied .deb files from pool/ after '
                             'metadata has been generated (metadata-only repository)')

    args = parser.parse_args()
    input_path = args.input
    output_path = args.output
    DISTRIBUTION = args.distribution
    COMPONENT = args.component

    debs_in_path = sorted(set(
        glob.glob(os.path.join(input_path, '*.deb')) +
        glob.glob(os.path.join(input_path, '*', '*.deb'))))
    if not debs_in_path:
        sys.exit('No .deb file found in ' + input_path)

    distribution_path = os.path.join(output_path, 'dists', DISTRIBUTION)
    pool_dir = os.path.join(output_path, 'pool', COMPONENT)

    # Clean the previous output for a deterministic rebuild.
    if os.path.isdir(distribution_path):
        shutil.rmtree(distribution_path)
    if os.path.isdir(pool_dir):
        shutil.rmtree(pool_dir)

    packages = []       # name, version, arch, control, pool_filename, deb_path, files
    real_arches = set()
    seen = set()

    for deb_path in debs_in_path:
        name, version, arch, control = parse_deb(deb_path)
        if arch not in SUPPORTED_ARCHES:
            sys.exit('Unsupported arch "{}" in {}'.format(
                arch, os.path.basename(deb_path)))
        if (name, version, arch) in seen:
            print('Warning: skipping duplicate package {}_{}_{} (source: {})'.format(
                name, version, arch, os.path.basename(deb_path)))
            continue
        seen.add((name, version, arch))

        filename = '{}_{}_{}.deb'.format(name, version, arch)
        pool_relative = os.path.join('pool', COMPONENT, name[0], name, filename)
        dest_path = os.path.join(output_path, pool_relative)
        os.makedirs(os.path.dirname(dest_path), exist_ok=True)

        print('Adding deb file: {} -> {}'.format(
            os.path.basename(deb_path), pool_relative))
        if args.use_hard_links:
            os.link(deb_path, dest_path)
        else:
            shutil.copy2(deb_path, dest_path)

        packages.append({
            'name': name,
            'version': version,
            'arch': arch,
            'control': control,
            'pool_filename': pool_relative,
            'deb_path': dest_path,
            'files': list_package_files(dest_path),
        })
        if arch != 'all':
            real_arches.add(arch)

    if not real_arches:
        sys.exit('No architecture-specific packages found; nothing to publish')

    all_packages = [p for p in packages if p['arch'] == 'all']

    # Packages, Contents and per-architecture Release files.
    for arch in sorted(real_arches):
        arch_dir = os.path.join(distribution_path, COMPONENT, 'binary-' + arch)
        os.makedirs(arch_dir, exist_ok=True)

        arch_packages = sorted(
            [p for p in packages if p['arch'] == arch] + all_packages,
            key=lambda p: p['name'])

        packages_path = os.path.join(arch_dir, 'Packages')
        with open(packages_path, 'w') as f:
            for p in arch_packages:
                if args.base_url:
                    deb_filename = args.base_url.rstrip('/') + '/' + \
                        os.path.basename(p['pool_filename'])
                else:
                    deb_filename = p['pool_filename']
                hashes = hash_file(p['deb_path'])
                body = p['control'].rstrip('\n') + '\n'
                body += 'Filename: ' + deb_filename + '\n'
                body += 'Size: ' + str(os.stat(p['deb_path']).st_size) + '\n'
                for h in HASHES:
                    field = 'MD5Sum' if h == 'md5' else h.upper()
                    body += field + ': ' + hashes[h] + '\n'
                f.write(body + '\n')

        with open(packages_path, 'rb') as fin:
            data = fin.read()
        with gzip.open(packages_path + '.gz', 'wb') as fout:
            fout.write(data)
        with bz2.open(packages_path + '.bz2', 'wb') as fout:
            fout.write(data)

        contents_path = os.path.join(
            distribution_path, COMPONENT, 'Contents-' + arch)
        contents_lines = sorted(
            '%-80s %s' % (fpath, p['name'])
            for p in arch_packages
            for fpath in p['files'])
        with open(contents_path, 'w') as f:
            for line in contents_lines:
                f.write(line + '\n')
        with open(contents_path, 'rb') as fin:
            data = fin.read()
        with gzip.open(contents_path + '.gz', 'wb') as fout:
            fout.write(data)

        with open(os.path.join(arch_dir, 'Release'), 'w') as f:
            f.write('Origin: {} {}\n'.format(ORIGIN, DISTRIBUTION))
            f.write('Label: {} {}\n'.format(ORIGIN, DISTRIBUTION))
            f.write('Archive: {}\n'.format(DISTRIBUTION))
            f.write('Suite: {}\n'.format(DISTRIBUTION))
            f.write('Codename: {}\n'.format(DISTRIBUTION))
            f.write('Architecture: {}\n'.format(arch))
            f.write('Component: {}\n'.format(COMPONENT))

    # Top-level Release file.
    release_entries = []
    for arch in sorted(real_arches):
        rel_dir = os.path.join(COMPONENT, 'binary-' + arch)
        for fn in ['Packages', 'Packages.gz', 'Packages.bz2', 'Release']:
            release_entries.append(os.path.join(rel_dir, fn))
        release_entries.append(os.path.join(COMPONENT, 'Contents-' + arch))
        release_entries.append(os.path.join(COMPONENT, 'Contents-' + arch + '.gz'))
    release_entries.sort()

    release_path = os.path.join(distribution_path, 'Release')
    with open(release_path, 'w') as f:
        f.write('Origin: {} {}\n'.format(ORIGIN, DISTRIBUTION))
        f.write('Label: {} {}\n'.format(ORIGIN, DISTRIBUTION))
        f.write('Suite: {}\n'.format(DISTRIBUTION))
        f.write('Codename: {}\n'.format(DISTRIBUTION))
        f.write('Date: {}\n'.format(
            datetime.datetime.now(datetime.timezone.utc).strftime(
                '%a, %d %b %Y %H:%M:%S UTC')))
        f.write('Architectures: {}\n'.format(' '.join(sorted(real_arches))))
        f.write('Components: {}\n'.format(COMPONENT))
        f.write('Description: {}\n'.format(DESCRIPTION))
        for h in HASHES:
            field = 'MD5Sum' if h == 'md5' else h.upper()
            f.write(field + ':\n')
            for rel in release_entries:
                path = os.path.join(distribution_path, rel)
                hashes = hash_file(path)
                f.write(' {} {} {}\n'.format(
                    hashes[h], os.stat(path).st_size, rel))

    if args.strip_debs:
        for p in packages:
            if os.path.exists(p['deb_path']):
                print('Stripping deb from output: ' + os.path.basename(p['deb_path']))
                os.remove(p['deb_path'])

    if args.sign:
        print('Signing with gpg...')
        gpg_cmd = 'gpg --yes --pinentry-mode loopback --digest-algo SHA256'
        passphrase = os.environ.get('GPG_PASSPHRASE')
        if passphrase:
            gpg_cmd += ' --passphrase ' + shlex.quote(passphrase)
        gpg_cmd += ' --clearsign -o ' + distribution_path + '/InRelease ' + release_path
        subprocess.check_call(
            [gpg_cmd], shell=True, universal_newlines=True)

    print('Done!')
    print('')
    print('Make the ' + output_path + ' directory accessible at $REPO_URL')
    print('')
    print('Users can then access the repo by adding a file at')
    print('   $PREFIX/etc/apt/sources.list.d')
    print('containing:')
    print('   deb [trusted=yes] $REPO_URL {} {}'.format(DISTRIBUTION, COMPONENT))
    print('')
    print('[trusted=yes] is not needed if the repo has been signed with a gpg key')


if __name__ == '__main__':
    main()
